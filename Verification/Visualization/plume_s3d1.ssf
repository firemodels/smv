// put rendered files in specified directory

RENDERDIR
 ..\..\Manuals\SMV_Verification_Guide\SCRIPT_FIGURES

UNLOADALL

// render 3D smoke files

UNLOADALL
LOADINIFILE
 plume_s3d1.ini
